# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Database and runtime storage
*.db
*.sqlite3
storage_data/
storage_data_test/

# Environment files with secrets
.env

# Pytest and coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Heavy audio binary artifacts (keep metadata/manifests/reports)
artifacts/**/*.wav
artifacts/**/*.mp3

# Excel submission and spreadsheet presentations (keep local only)
*.xlsx
*.xls

# Confidential assessment brief and documents
*.pdf
docs/submission_*
docs/final_submission_audit.md
docs/final_submission_answers.md
docs/audit_report.md

# Frontend dependencies and production build outputs
node_modules/
frontend/node_modules/
frontend/dist/

