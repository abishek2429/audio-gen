# ==============================================================================
# IncuBrix AI Background Music Engine — Environment Configuration Specification
# ==============================================================================
# Copy this file to '.env' and adjust values for your environment.
# Never commit real credentials, API tokens, or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Music Generation & Stem Separation Providers
# ------------------------------------------------------------------------------
# Active Provider: 'mock' (default offline), 'soundverse', or 'elevenlabs'
MUSIC_PROVIDER=mock

# Primary Provider: Soundverse Enterprise API
# Platform: https://platform.soundverse.ai
SOUNDVERSE_API_KEY=your_soundverse_api_key_here
SOUNDVERSE_BASE_URL=https://apiv2.soundverse.ai
SOUNDVERSE_MODEL_VERSION=v2-turbo

# Fallback Provider: ElevenLabs Music API
# Platform: https://elevenlabs.io/eleven-music-api
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_VERSION=music_v1

# ------------------------------------------------------------------------------
# 2. Database & State Persistence
# ------------------------------------------------------------------------------
# Local Development default: SQLite (sqlite:///./incubrix.db)
# Docker Compose / Production: PostgreSQL (postgresql+psycopg://postgres:postgres@localhost:5432/incubrix)
DATABASE_URL=sqlite:///./incubrix.db

# PostgreSQL Container Credentials (used by docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=incubrix
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 3. Redis Task Broker & Celery Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ENABLED=false
CELERY_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 4. S3-Compatible Object Storage (MinIO / AWS S3)
# ------------------------------------------------------------------------------
# Backend: 'minio' or 'local'
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data

# MinIO / S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=incubrix-audio
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 5. Security, Access Protection & Webhook Callbacks
# ------------------------------------------------------------------------------
# Demo Access Protection: Optional API key. When set, clients must pass this
# token in 'X-API-Key' or 'Authorization: Bearer <key>' on protected endpoints.
# Leave blank to permit unrestricted local development.
DEMO_API_KEY=

# Rate Limiting: Max requests per minute per client IP (0 disables throttling)
RATE_LIMIT_PER_MINUTE=60

# Max Upload / Request Payload Size in bytes (default: 52428800 = 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Webhook Callback Security (HMAC-SHA256 signature in X-IncuBrix-Signature)
CALLBACK_SECRET=incubrix-default-hmac-secret-change-in-prod

# ------------------------------------------------------------------------------
# 6. Audio Engineering & DSP Quality Standards (ITU-R BS.1770-4 / EBU R128)
# ------------------------------------------------------------------------------
DEFAULT_SAMPLE_RATE=48000
TARGET_LUFS=-16.0
TARGET_TRUE_PEAK_DBTP=-1.0
DURATION_TOLERANCE_S=0.05
MAX_TRACK_DURATION_S=300.0
MIN_TRACK_DURATION_S=5.0
MIN_SECTION_GAP_S=1.5

# ------------------------------------------------------------------------------
# 7. System, Logging & Networking
# ------------------------------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
APP_ENV=development
