# ==============================================================================
# IncuBrix AI Background Music Engine — Environment Configuration
# ==============================================================================

# Active Music Provider: 'mock' (default offline), 'soundverse', or 'elevenlabs'
MUSIC_PROVIDER=mock

# Primary Provider: Soundverse Enterprise API
# https://platform.soundverse.ai
SOUNDVERSE_API_KEY=
SOUNDVERSE_BASE_URL=https://apiv2.soundverse.ai

# Fallback Provider: ElevenLabs Music API
# https://elevenlabs.io/eleven-music-api
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Audio DSP Standards (ITU-R BS.1770-4 / EBU R128)
DEFAULT_SAMPLE_RATE=48000
TARGET_LUFS=-16.0
TARGET_TRUE_PEAK_DBTP=-1.0
DURATION_TOLERANCE_S=0.05

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
