# ==============================================================================
# IncuBrix AI Background Music Engine — Environment Configuration
# ==============================================================================

# Active Music Provider: 'mock' (default offline), 'soundverse', or 'elevenlabs'
MUSIC_PROVIDER=mock

# Primary Provider: Soundverse Enterprise API
# https://platform.soundverse.ai
SOUNDVERSE_API_KEY=
SOUNDVERSE_BASE_URL=https://apiv2.soundverse.ai

# Fallback Provider: ElevenLabs Music API
# https://elevenlabs.io/eleven-music-api
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Database Configuration (PostgreSQL in container, SQLite locally)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/incubrix

# Redis Task Broker & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ENABLED=false

# Object Storage: 'minio' or 'local'
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=incubrix-audio
MINIO_SECURE=false
LOCAL_STORAGE_DIR=./storage_data

# Webhook Callback Security (HMAC-SHA256 signature in X-IncuBrix-Signature)
CALLBACK_SECRET=incubrix-default-hmac-secret-change-in-prod
MAX_UPLOAD_SIZE_BYTES=52428800

# Public Demo Authentication & Rate Limiting (Optional)
DEMO_API_KEY=
RATE_LIMIT_PER_MINUTE=60

# Audio DSP Standards (ITU-R BS.1770-4 / EBU R128)
DEFAULT_SAMPLE_RATE=48000
TARGET_LUFS=-16.0
TARGET_TRUE_PEAK_DBTP=-1.0
DURATION_TOLERANCE_S=0.05

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
